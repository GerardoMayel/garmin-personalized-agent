# =====================================================================
# Garmin Personal Insight Agent - Environment Configuration
# =====================================================================

# Garmin Connect Credentials
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_TOKEN_STORE=~/.garminconnect

# API & Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
UI_PORT=8501
DEBUG=false
ENVIRONMENT=development

# LLM & Reasoning Engine API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
HUGGINGFACE_TOKEN=hf_...
GEMINI_API_KEY=your_gemini_api_key_here

# Vector Database (Qdrant / ChromaDB)
VECTOR_DB_TYPE=qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# Fine-Tuning & Model Paths
BASE_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
LORA_CHECKPOINT_DIR=./checkpoints/lora_adapter
OUTPUT_DIR=./models/finetuned_garmin_agent

# Storage & Data Paths
DATA_DIR=./data
RAW_DATA_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed
KNOWLEDGE_BASE_PATH=./data/knowledge_base
LOG_LEVEL=INFO
 
# Cloudflare R2 Object Storage (S3-Compatible)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=garmin-personal-data
R2_ENDPOINT_URL=https://<your_account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
