# =====================================================================
# Garmin Personal Insight Agent - Environment Configuration
# =====================================================================

# Garmin Connect Credentials (Ingestion & Session Management)
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_TOKEN_STORE=~/.garminconnect

# Local SQLite Database (Default: data/garmin_personal.db)
GARMIN_DB_PATH=data/garmin_personal.db

# Logging Configuration (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Google Gemini API Key (Optional fallback for hybrid NLP language detection in RAG)
GEMINI_API_KEY=

# Hugging Face Credentials (Model Hub, Embeddings & Rerankers)
HUGGINGFACE_TOKEN=
HF_TOKEN=

# Vector Database Configuration (ChromaDB on Hugging Face Spaces or Local)
CHROMA_REMOTE_URL=https://<your_hf_username>-garmin-chroma-backend.hf.space


# Cloudflare R2 Object Storage (S3-Compatible Remote Storage for Data & Knowledge Base)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=garmin-personal-data
R2_ENDPOINT_URL=https://<your_account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
