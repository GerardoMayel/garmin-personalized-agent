# =====================================================================
# Garmin Personal Insight Agent - Environment Configuration
# =====================================================================

# Garmin Connect Credentials
GARMIN_EMAIL=your_email@example.com
GARMIN_PASSWORD=your_secure_password
GARMIN_TOKEN_STORE=~/.garmin_tokens

# API & Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
UI_PORT=8501
DEBUG=false
ENVIRONMENT=development

# LLM & Reasoning Engine API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
HUGGINGFACE_TOKEN=hf_...

# Vector Database (Qdrant / ChromaDB)
VECTOR_DB_TYPE=qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# Fine-Tuning & Model Paths
BASE_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
LORA_CHECKPOINT_DIR=./checkpoints/lora_adapter
OUTPUT_DIR=./models/finetuned_garmin_agent

# Storage & Data Paths
DATA_DIR=./data
RAW_DATA_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed
KNOWLEDGE_BASE_PATH=./data/knowledge_base
LOG_LEVEL=INFO
